# Django Deployment Configuration
DEBUG=False
SECRET_KEY=your-random-production-secret-key-at-least-50-characters
ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://*.onrender.com,https://b-bakery-tan.vercel.app

# Neon Database Connection (Pooled)
DATABASE_URL=postgresql://neondb_owner:<your-neon-password>@<your-neon-endpoint>-pooler.<region>.aws.neon.tech/neondb?sslmode=require

# Paystack API Keys
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here
PAYSTACK_SECRET_KEY=sk_test_your_secret_key_here
